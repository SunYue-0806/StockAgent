# ============================================================
# ZiMoMo 环境变量配置模板
# 使用方法：cp .env.example .env，然后填入你的实际值
# ============================================================

# ── LLM 配置（必填） ──────────────────────────────────────
# API 密钥（支持 OpenAI 兼容接口，如阿里云百炼、DeepSeek 等）
LLM_API_KEY=sk-your-api-key-here

# API 基础地址（OpenAI 官方: https://api.openai.com/v1）
# 阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:   https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型 ID（如 gpt-4o、qwen-plus、deepseek-chat 等）
LLM_MODEL_ID=gpt-4o

# 请求超时时间（秒）
LLM_TIMEOUT=60

# ── LLM 高级参数（可选） ──────────────────────────────────
# 生成温度 (0.0 - 2.0)，越低越确定性
# TEMPERATURE=0.7

# 最大生成 Token 数（留空则使用模型默认值）
# MAX_TOKENS=4000

# ── 天气工具（可选） ──────────────────────────────────────
# 心知天气 API Key（https://www.seniverse.com/ 注册获取）
# 不配置则天气工具不可用
XIN_ZHI_WEATHER_API_KEY=your-seniverse-api-key-here

# ── 记忆系统（开发中，暂不生效） ──────────────────────────
# Qdrant 向量数据库地址
# QDRANT_URL=http://localhost:6333

# Qdrant API Key（如果启用了认证）
# QDRANT_API_KEY=

# Neo4j 知识图谱连接
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# Embedding 模型（用于向量化记忆内容）
# EMBEDDING_MODEL=text-embedding-3-small

# ── 调试与日志（可选） ────────────────────────────────────
# 调试模式 (true / false)
# DEBUG=false

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
# LOG_LEVEL=INFO

# 日志文件输出目录（留空则不输出到文件）
# LOG_DIR=

# ── 会话存储（可选） ──────────────────────────────────────
# 会话 JSONL 文件存储目录（默认: data/sessions）
# SESSION_DATA_DIR=data/sessions
